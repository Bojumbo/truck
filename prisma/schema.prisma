// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  created_at DateTime @default(now())
  shifts     Shift[]

  @@map("users")
}

model Shift {
  id               Int           @id @default(autoincrement())
  user_id          Int           @default(1)
  truck_number     String        @db.VarChar(20)
  trailer_number   String?       @db.VarChar(20)
  trailer_type     TrailerType
  card_inserted_at DateTime
  card_removed_at  DateTime?
  odometer_start   Int
  odometer_end     Int?
  ref_hours_start  Decimal?      @db.Decimal(8, 1)
  ref_hours_end    Decimal?      @db.Decimal(8, 1)
  status           ShiftStatus   @default(active)
  created_at       DateTime      @default(now())

  user             User          @relation(fields: [user_id], references: [id])
  tacho_logs       TachoLog[]
  trip_logs        TripLog[]
  expenses         Expense[]

  @@map("shifts")
}

model TachoLog {
  id               Int        @id @default(autoincrement())
  shift_id         Int
  mode             TachoMode
  start_time       DateTime
  end_time         DateTime?
  duration_minutes Int?

  shift            Shift      @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@map("tacho_logs")
}

model TripLog {
  id           Int           @id @default(autoincrement())
  shift_id     Int
  event_type   TripEventType
  border_name  String?       @db.VarChar(100)
  odometer     Int
  comment      String?       @db.Text
  timestamp    DateTime

  shift        Shift         @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@map("trip_logs")
}

model Expense {
  id               Int            @id @default(autoincrement())
  shift_id         Int
  payment_type     PaymentType
  category         ExpenseCategory
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("EUR") @db.VarChar(5)
  comment          String?        @db.Text
  receipt_photo_url String?       @db.VarChar(255)
  timestamp        DateTime

  shift            Shift          @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@map("expenses")
}

// ---- Enums ----
enum TrailerType {
  tent
  ref
  box
  other
}

enum ShiftStatus {
  active
  closed
}

enum TachoMode {
  hammer
  bed
  driving
}

enum TripEventType {
  transit_start
  transit_end
  border_crossing
  loading_start
  loading_end
  unloading_start
  unloading_end
}

enum PaymentType {
  company
  personal
}

enum ExpenseCategory {
  fuel
  adblue
  toll
  parking
  repair
  other
}
